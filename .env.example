# ---------------------------------------------------------------------------
# AURELIA — Environment variables
# Copy to .env.local and fill in. The app runs in DEMO MODE when Appwrite
# values are left blank (uses a local seeded JSON store under .data/).
# ---------------------------------------------------------------------------

# Appwrite (server + browser)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=aurelia
# Server-side API key — NEVER expose this to the browser. Needs database +
# collection read/write and users.write scopes.
APPWRITE_API_KEY=

# Appwrite collection IDs (defaults shown)
APPWRITE_COLLECTION_PRODUCTS=products
APPWRITE_COLLECTION_VARIANTS=product_variants
APPWRITE_COLLECTION_CATEGORIES=categories
APPWRITE_COLLECTION_BRANDS=brands
APPWRITE_COLLECTION_REVIEWS=reviews
APPWRITE_COLLECTION_ORDERS=orders
APPWRITE_COLLECTION_ADDRESSES=addresses
APPWRITE_COLLECTION_WISHLISTS=wishlists
APPWRITE_COLLECTION_CARTS=carts
APPWRITE_COLLECTION_RETURNS=returns
APPWRITE_COLLECTION_COUPONS=coupons
APPWRITE_COLLECTION_REDEMPTIONS=coupon_redemptions
APPWRITE_COLLECTION_NEWSLETTER=newsletter_subscribers
APPWRITE_COLLECTION_SETTINGS=store_settings
APPWRITE_COLLECTION_CONTENT=homepage_content
APPWRITE_COLLECTION_AUDIT=audit_logs
APPWRITE_COLLECTION_INVENTORY=inventory_movements
APPWRITE_COLLECTION_WEBHOOKS=payment_webhook_events
# Create a bucket with public read access when using Appwrite Storage
APPWRITE_STORAGE_BUCKET_ID=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=AURELIA
NEXT_PUBLIC_CURRENCY=GHS
NEXT_PUBLIC_CURRENCY_SYMBOL=GH₵

# Paystack (server only)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Stripe (optional, server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email, server only)
RESEND_API_KEY=
EMAIL_FROM=AURELIA <hello@aurelia.example>

# Demo-mode session signing (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production-super-secret-value
